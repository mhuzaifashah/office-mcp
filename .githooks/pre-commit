#!/usr/bin/env sh
# Local pre-commit checks: lint + format on staged Python, and a guard against
# committing private references (absolute machine paths, terms in .private-terms).
set -e
cd "$(git rev-parse --show-toplevel)"

ruff=.venv/Scripts/ruff.exe
[ -x "$ruff" ] || ruff=.venv/bin/ruff

py_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
if [ -n "$py_files" ]; then
  $ruff check $py_files
  $ruff format --check $py_files
fi

pattern='/mnt/[a-z]/|[A-Za-z]:\\Users\\'
if [ -f .private-terms ]; then
  extra=$(grep -vE '^\s*(#|$)' .private-terms | paste -sd'|' -)
  [ -n "$extra" ] && pattern="$pattern|$extra"
fi
if git diff --cached -U0 --diff-filter=ACMR | grep '^+' | grep -v '^+++' | grep -inE "$pattern"; then
  echo "pre-commit: blocked, staged lines above contain a private reference." >&2
  exit 1
fi
